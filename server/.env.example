# MongoDB connection string (MongoDB Atlas free tier works fine)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nirveonx-erp?retryWrites=true&w=majority

# Long random string used to sign JWTs - generate your own, never reuse this example
JWT_SECRET=replace-this-with-a-long-random-string

# Port the API server listens on
PORT=8080

# Comma-separated list of allowed frontend origins (for CORS)
CLIENT_ORIGIN=http://localhost:5173

FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"...", ...}'